# Clé API Anthropic — obtenir sur https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Modèles Claude utilisés
# Note : Sonnet 4.5 a été retiré, on utilise Sonnet 4.6 (performances équivalentes)
MODEL_SONNET=claude-sonnet-4-6
MODEL_HAIKU=claude-haiku-4-5-20251001

# true = synthèses fictives, zéro appel Claude, zéro coût (recommandé pour débuter)
MOCK_MODE=true

# Taux de change USD → EUR pour le calcul des coûts affichés
EUR_USD_RATE=0.92

# Ports des serveurs locaux
BACKEND_PORT=8000
STREAMLIT_PORT=8501
